generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  free
  solo
  master
}

enum PlanStatus {
  active
  trialing
  past_due
  cancelled
}

enum BillingPeriod {
  monthly
  annual
}

enum Role {
  user
  admin
}

enum EpisodeStatus {
  draft
  researching
  focusing
  questions
  intro
  script
  video
  review
  approved
  published
}

enum ShowCategory {
  interview
  solo
  narrative
  panel
  educational
  comedy
}

enum ShowStatus {
  active
  paused
  archived
}

enum InterviewStyle {
  conversational
  deep_dive
  fast_paced
  philosophical
  challenging
  supportive
  comedic
}

enum HostEnergy {
  warm_casual
  professional_structured
  curious_exploratory
  edgy_provocative
  inspirational
}

enum LanguageLevel {
  simple_accessible
  moderate
  advanced_technical
}

enum HumorLevel {
  none
  light
  medium
  heavy
}

enum Pacing {
  slow_deep
  balanced
  fast_punchy
}

enum GuestIntroStyle {
  host_reads_bio
  guest_introduces_themselves
  host_tells_a_story_about_guest
  no_intro_dive_straight_in
}

enum PublishFrequency {
  weekly
  biweekly
  monthly
  variable
}

enum GuestStatus {
  wishlist
  outreach_sent
  confirmed
  recorded
  published
}

enum InfluencerPlatform {
  Instagram
  YouTube
  TikTok
  Twitter_X
  LinkedIn
  Podcast
  Other
}

enum CommissionType {
  percentage
  fixed
}

enum InfluencerStatus {
  active
  paused
  pending
}

enum InfluencerStep {
  invited
  agreement_sent
  agreement_signed
  stripe_connected
  active
}

enum PayoutStatus {
  success
  failed
  skipped
}

enum AvailabilityStatus {
  available
  busy
}

enum CommentType {
  feedback
  revision_request
  approval
  general
}

enum MessageType {
  chat
  announcement
}

model User {
  id                         String         @id @default(cuid())
  email                      String         @unique
  fullName                   String?
  passwordHash               String?
  emailVerified              DateTime?
  image                      String?
  role                       Role           @default(user)
  hostName                   String?
  showName                   String?
  showDescription            String?
  showCategory               String?
  targetAudience             String?
  plan                       Plan           @default(free)
  planStatus                 PlanStatus     @default(active)
  planOverride               Boolean        @default(false)
  trialEndsAt                DateTime?
  stripeCustomerId           String?        @unique
  stripeSubscriptionId       String?        @unique
  stripePriceId              String?
  subscriptionStart          DateTime?
  billingPeriod              BillingPeriod?
  subscriptionRenewedAt      DateTime?
  currentPeriodEnd           DateTime?
  cancelAtPeriodEnd          Boolean        @default(false)
  aiResearchCountThisMonth   Int            @default(0)
  brandColors                Json?
  brandLogoUrl               String?
  brandAppName               String?
  googleCalendarConnected    Boolean        @default(false)
  googleCalendarToken        String?
  googleCalendarRefreshToken String?
  skippedDnaSetup            Boolean        @default(false)
  onboardingComplete         Boolean        @default(false)
  // Wizard Step 1 onboarding strip: false until the user dismisses the
  // "First time? Rewatch the demo" banner.
  seenWizardIntro            Boolean        @default(false)
  // Reverse trial: set true once the "your trial ended" modal has been shown,
  // so it appears exactly once after expiry.
  trialEndedNoticeShown      Boolean        @default(false)
  // Reverse trial: set true once the day-5 "2 days left" email has gone out,
  // so the daily cron never sends it twice.
  trialReminderSent          Boolean        @default(false)
  // Reverse trial: set true once the first-sign-in "Claim your 7 days" modal
  // has been shown, so it appears exactly once.
  trialWelcomeSeen           Boolean        @default(false)
  // UI + AI-output language preference ("en" default, "he" = Hebrew/RTL).
  language                   String         @default("en")
  emailConnected             Boolean        @default(false)
  connectedEmail             String?
  emailProvider              String?
  notifyTeamOnAvailability   Boolean        @default(true)
  appliedCouponCode          String?
  couponDiscountDescription  String?
  lastExport                 DateTime?
  // First-time milestone keys the user has already been prompted to review.
  // Each first-step review chat bubble fires once, then its key is recorded here.
  reviewedMilestones         String[]       @default([])
  // Marketing email opt-in. Defaults true; flipped to false when the user
  // clicks the unsubscribe link in any campaign email. Transactional emails
  // (welcome, billing, password reset) ignore this flag.
  marketingEmailOptIn        Boolean        @default(true)
  // Lazily-generated opaque token used to authenticate the unsubscribe link.
  // We never put the user id or email in the URL.
  unsubscribeToken           String?        @unique
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  shows              Show[]
  episodes           Episode[]           @relation("EpisodeCreator")
  guests             Guest[]
  availabilityBlocks AvailabilityBlock[]
  episodeComments    EpisodeComment[]
  teamMessages       TeamMessage[]
  accounts           Account[]
  sessions           Session[]
}

model Show {
  id                          String            @id @default(cuid())
  name                        String
  description                 String?
  category                    ShowCategory?
  coverImageUrl               String?
  hostName                    String?
  targetAudience              String?
  ownerEmail                  String
  owner                       User              @relation(fields: [ownerEmail], references: [email])
  memberEmails                String[]          @default([])
  memberRoles                 Json?
  pendingInvites              String[]          @default([])
  requireApproval             Boolean           @default(true)
  publishFrequency            PublishFrequency?
  rssUrl                      String?
  status                      ShowStatus        @default(active)
  episodeSections             Json?
  typicalEpisodeLengthMinutes Int               @default(45)
  interviewStyle              InterviewStyle    @default(conversational)
  hostEnergy                  HostEnergy        @default(warm_casual)
  languageLevel               LanguageLevel     @default(moderate)
  humorLevel                  HumorLevel        @default(light)
  pacing                      Pacing            @default(balanced)
  openingLine                 String?
  closingQuestion             String?
  topicsToAvoid               String?
  guestIntroStyle             GuestIntroStyle   @default(host_reads_bio)
  recurringSegments           String?
  showValues                  String?
  interviewInfluences         String[]          @default([])
  interviewStyleDescription   String?
  includeVideoStep            Boolean           @default(false)
  includePromoteStep          Boolean           @default(false)
  aiResearchInstructions      String?
  aiQuestionInstructions      String?
  aiScriptInstructions        String?
  aiSocialInstructions        String?
  // Flipped true the first time a user edits this show's DNA (auto-save on the
  // DNA page). Drives the "first Show DNA set" review milestone.
  dnaConfigured               Boolean           @default(false)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  episodes           Episode[]
  teamMessages       TeamMessage[]
  availabilityBlocks AvailabilityBlock[]

  @@index([ownerEmail])
}

model Episode {
  id                    String        @id @default(cuid())
  title                 String?
  description           String?
  // Optional episode cover art, set on the Share step. Distinct from
  // guestPhotoUrl (the guest's headshot fetched during research).
  coverImageUrl         String?
  showId                String?
  show                  Show?         @relation(fields: [showId], references: [id])
  hostName              String?
  guestName             String
  guestBio              String?
  guestResearch         String?
  guestPhotoUrl         String?
  guestLinkedinUrl      String?
  guestTwitterUrl       String?
  guestInstagramUrl     String?
  guestWebsiteUrl       String?
  guestExtraContext     String?
  funFacts              String[]      @default([])
  focusAnswers          Json?
  interviewInfluences   String[]      @default([])
  influenceProfiles     Json?
  generatedQuestions    Json?
  selectedQuestions     Json?
  favoriteQuestions     Json?
  introductionScript    String?
  fullScript            String?
  introVideoUrl         String?
  teamId                String?
  releaseDate           DateTime?
  briefUrl              String?
  briefSentAt           DateTime?
  publishedAt           DateTime?
  socialContent         Json?
  status                EpisodeStatus @default(draft)
  currentStep           Int           @default(1)
  sharedWith            String[]      @default([])
  managerEmail          String?
  managerApproved       Boolean       @default(false)
  googleCalendarEventId String?
  teamCalendarEventIds  Json?
  createdByEmail        String
  createdBy             User          @relation("EpisodeCreator", fields: [createdByEmail], references: [email])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  comments EpisodeComment[]

  @@index([showId])
  @@index([createdByEmail])
}

model Guest {
  id               String      @id @default(cuid())
  name             String
  photoUrl         String?
  bio              String?
  researchNotes    String?
  linkedinUrl      String?
  twitterUrl       String?
  websiteUrl       String?
  topics           String[]    @default([])
  pipelineStatus   GuestStatus @default(wishlist)
  outreachNotes    String?
  ownerEmail       String
  owner            User        @relation(fields: [ownerEmail], references: [email])
  episodeIds       String[]    @default([])
  timesInterviewed Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([ownerEmail])
}

model Team {
  id           String   @id @default(cuid())
  name         String
  ownerEmail   String
  showId       String?
  memberEmails String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerEmail])
  @@index([showId])
}

model EpisodeComment {
  id          String      @id @default(cuid())
  episodeId   String
  episode     Episode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  message     String
  authorName  String?
  authorEmail String
  author      User        @relation(fields: [authorEmail], references: [email])
  type        CommentType @default(general)
  createdAt   DateTime    @default(now())
}

model TeamMessage {
  id          String      @id @default(cuid())
  showId      String
  show        Show        @relation(fields: [showId], references: [id], onDelete: Cascade)
  senderEmail String
  sender      User        @relation(fields: [senderEmail], references: [email])
  senderName  String?
  message     String
  messageType MessageType @default(chat)
  createdAt   DateTime    @default(now())

  @@index([showId])
}

model AvailabilityBlock {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  userEmail String
  date      DateTime           @db.Date
  timeFrom  String?
  timeTo    String?
  status    AvailabilityStatus @default(available)
  note      String?
  showId    String?
  show      Show?              @relation(fields: [showId], references: [id])
  createdAt DateTime           @default(now())
}

model Influencer {
  id                        String              @id @default(cuid())
  name                      String
  email                     String?             @unique
  handle                    String?
  platform                  InfluencerPlatform?
  followersCount            Int?
  couponCode                String?             @unique
  referralLink              String?
  commissionType            CommissionType?
  commissionValue           Float?
  customerDiscount          Float?
  stripeCouponId            String?
  stripePromotionCodeId     String?
  planAccess                String?
  status                    InfluencerStatus    @default(pending)
  notes                     String?
  stripeAccountId           String?
  stripeOnboardingSent      Boolean             @default(false)
  stripeOnboardingCompleted Boolean             @default(false)
  couponActive              Boolean             @default(false)
  agreementSentDate         DateTime?           @db.Date
  agreementSignedDate       DateTime?           @db.Date
  agreementSigned           Boolean             @default(false)
  agreementSignatureToken   String?             @unique
  agreementIpAddress        String?
  onboardingStep            InfluencerStep      @default(invited)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  conversions   InfluencerConversion[]
  payouts       PayoutLog[]
  clicks        ReferralClick[]
  attributions  ReferralAttribution[]
}

// Public-facing applications collected from the /partners page. Stays separate
// from Influencer so we keep "applied" noise out of the real influencer roster
// until an admin approves the application.
model InfluencerApplication {
  id                      String              @id @default(cuid())
  name                    String
  email                   String
  handle                  String?
  platform                InfluencerPlatform?
  followersCount          Int?
  socialLinks             Json?
  audienceSize            String?
  whyJoin                 String
  status                  String              @default("pending")
  rejectionReason         String?
  reviewedAt              DateTime?
  reviewedBy              String?
  convertedToInfluencerId String?             @unique
  ipAddress               String?
  createdAt               DateTime            @default(now())
}

// Every visit that arrives via ?ref=<code>. One row per click for funnel analytics.
model ReferralClick {
  id           String     @id @default(cuid())
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  visitorId    String
  landingPath  String
  userAgent    String?
  referrer     String?
  ipHash       String?
  createdAt    DateTime   @default(now())

  @@index([influencerId, createdAt])
  @@index([visitorId])
}

// First-touch attribution that survives across sessions. Created at signup when
// we see a bas_ref cookie, OR at checkout when an influencer's coupon is used.
// One per user; first attribution wins.
model ReferralAttribution {
  id           String     @id @default(cuid())
  userEmail    String     @unique
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  visitorId    String
  attributedAt DateTime   @default(now())
  expiresAt    DateTime
  source       String
  rawCode      String?

  @@index([influencerId])
}

model InfluencerConversion {
  id                 String     @id @default(cuid())
  influencerId       String
  influencer         Influencer @relation(fields: [influencerId], references: [id])
  convertedUserEmail String
  conversionDate     DateTime   @default(now()) @db.Date
  planPurchased      Plan
  revenueAmount      Float?
  commissionEarned   Float?
  commissionPaid     Boolean    @default(false)
  couponCodeUsed     String?
  notes              String?
}

model CouponCode {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountType       String
  discountValue      Float
  applicablePlan     String?
  maxUses            Int       @default(0)
  usesSoFar          Int       @default(0)
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  createdByEmail     String?
  notes              String?
  linkedInfluencerId String?
  stripeCouponId        String?
  stripePromotionCodeId String?
  createdAt          DateTime  @default(now())
}

model PayoutLog {
  id               String       @id @default(cuid())
  payoutDate       DateTime     @db.Date
  influencerId     String
  influencer       Influencer   @relation(fields: [influencerId], references: [id])
  influencerName   String?
  amountUsd        Float?
  stripeTransferId String?
  conversionsPaid  Int?
  status           PayoutStatus @default(success)
  errorMessage     String?
  triggeredBy      String?
  createdAt        DateTime     @default(now())
}

model UserFeedback {
  id        String   @id @default(cuid())
  userEmail String?
  userName  String?
  type      String?
  message   String
  source    String?
  question  String?
  rating    Int?
  page      String?
  createdAt DateTime @default(now())
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Marketing email campaigns written from the admin page. The cron job picks the
// oldest DRAFT (FIFO) on each scheduled run and sends it to every free-plan
// user who hasn't unsubscribed. After it goes out the row is flipped to SENT so
// the next run picks the next campaign in the queue.
model MarketingEmailCampaign {
  id          String                       @id @default(cuid())
  subject     String
  // Full HTML body (admin-authored). The cron path wraps it in the branded
  // shell + unsubscribe footer before sending.
  html        String
  // Optional inbox-preview line. Falls back to a generic preheader when blank.
  preheader   String?
  status      MarketingEmailCampaignStatus @default(DRAFT)
  // Which user cohort the cron sends this campaign to. Defaults to FREE so the
  // primary conversion funnel keeps working without an audience choice.
  audience    MarketingEmailCampaignAudience @default(FREE)
  // True for AI-drafted campaigns that haven't been approved yet. The send cron
  // ignores anything with needsReview=true so a fresh AI draft never ships
  // without an admin Approve click.
  needsReview Boolean                        @default(false)
  sentAt      DateTime?
  // How many recipients this campaign actually reached. Useful for the admin
  // to see at a glance what coverage each send got.
  sentCount   Int                          @default(0)
  createdByEmail String
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
}

enum MarketingEmailCampaignStatus {
  DRAFT
  SENT
}

// Cohort of users a campaign should reach. ALL = every opted-in user; the
// others narrow to a single plan tier.
enum MarketingEmailCampaignAudience {
  FREE
  SOLO
  MASTER
  ALL
}

// WhatsApp 7-step episode prep conversation. One row per phone number;
// progresses through steps as messages arrive. Linked to a Ba Studio User by
// email so generated episodes save to the user's account.
model WhatsAppConversation {
  id          String       @id @default(cuid())
  phoneNumber String       @unique  // e.g. "whatsapp:+972501234567"
  step        WhatsAppStep @default(IDLE)
  // Account link. Set after the user verifies their Ba Studio email.
  userEmail   String?
  // The in-progress Episode this conversation is building. Created once the
  // guest's name is known; updated as more data accumulates.
  episodeId   String?
  guestName   String?
  angle       String?      // business / personal / craft / etc.
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum WhatsAppStep {
  IDLE
  AWAITING_EMAIL
  AWAITING_GUEST_NAME
  AWAITING_GUEST_LINKS
  AWAITING_ANGLE
  GENERATING
}


// One row per founder-outreach email send (and any reply later captured).
// Written by /api/admin/outreach. Idempotent: a userId with status 'sent' is
// never emailed again. Table created by migration create_outreach_log.
model OutreachLog {
  id        String    @id @default(cuid())
  userId    String
  email     String
  variant   String // 'activated' | 'bounced'
  status    String    @default("pending") // pending | sent | failed | skipped
  sentAt    DateTime?
  error     String?
  resendId  String?
  repliedAt DateTime?
  replyText String?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([userId])
}
